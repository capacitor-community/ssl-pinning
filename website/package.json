{
  "name": "ssl-pinning-docs-website",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start-docs": "TYPEDOC_WATCH=true && npm run clean-generated && docusaurus start",
    "build-docs": "TYPEDOC_WATCH=false && npm run clean-generated && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "clean-generated": "rimraf ./docs/classes ./docs/interfaces"
  },
  "dependencies": {
    "@algolia/client-search": "~4.14.2",
    "@docusaurus/core": "^3.1.1",
    "@docusaurus/theme-classic": "^3.1.1",
    "@ionic-docs/preset-classic": "^1.1.5",
    "@ionic/prettier-config": "^2.0.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^1.1.1",
    "prettier": "^2.3.2",
    "prism-react-renderer": "^2.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "~7.20.5",
    "@docusaurus/module-type-aliases": "^3.1.1",
    "@docusaurus/tsconfig": "^3.1.1",
    "@docusaurus/types": "^3.1.1",
    "@types/rimraf": "3.0.2",
    "docusaurus-plugin-typedoc": "^0.22.0",
    "rimraf": "3.0.2",
    "rollup": "~2.4.0",
    "typedoc": "^0.25.9",
    "typedoc-plugin-markdown": "^3.17.1",
    "typescript": "~5.2.2",
    "webpack": "~5.75.0"
  }
}
